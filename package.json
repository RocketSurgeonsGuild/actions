{
  "name": "rsg-actions",
  "version": "0.0.0",
  "private": true,
  "description": "Rocket Surgeons Actions",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "oxlint --fix",
    "dist": "npm run dist:merge-labels && npm run dist:sync-milestone && npm run dist:auto-label",
    "dist:merge-labels": "esbuild ./merge-labels/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=./merge-labels/dist/index.js",
    "dist:sync-milestone": "esbuild ./sync-milestone/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=./sync-milestone/dist/index.js",
    "dist:auto-label": "esbuild ./auto-label/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=./auto-label/dist/index.js",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run dist && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Rocket Surgeons Guild",
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/cache": "6.3.0",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@actions/glob": "0.7.0",
    "@actions/http-client": "4.0.1",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.11",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "ix": "7.0.0",
    "jest": "30.5.2",
    "jest-circus": "30.5.2",
    "jest-cli": "30.5.2",
    "js-yaml": "5.5.0",
    "lint-staged": "17.6.2",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "prettier": "3.10.1",
    "rxjs": "7.8.2",
    "typescript": "7.0.2"
  }
}
